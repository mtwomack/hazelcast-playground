# Copy this file to .env and change values as needed:
#   copy .env.example .env
# Real environment variables override values in .env.

# Hazelcast member addresses, comma-separated
HZ_MEMBERS=127.0.0.1:5701

# Cluster name (dev is Hazelcast's default)
HZ_CLUSTER_NAME=dev

# Docker container name used by the /stats/hazelcast endpoint
HZ_CONTAINER=hazelcast
